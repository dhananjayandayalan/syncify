{
  "name": "syncify-api",
  "version": "1.0.0",
  "description": "Syncify REST API — cross-platform playlist sync",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/jobs/worker.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/jwt": "^9.1.0",
    "@fastify/rate-limit": "^10.2.2",
    "fastify-type-provider-zod": "^5.0.3",
    "@prisma/client": "^6.9.0",
    "bullmq": "^5.53.2",
    "fastify": "^5.3.3",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^5.4.2",
    "zod": "^3.25.36"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}
