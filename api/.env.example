# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# PostgreSQL — get free DB at https://supabase.com
DATABASE_URL=postgresql://user:password@host:5432/syncify

# Redis — get free instance at https://upstash.com
REDIS_URL=redis://default:password@host:6379

# JWT — at least 32 random characters
JWT_SECRET=change-me-to-a-long-random-secret-string-here
JWT_EXPIRES_IN=15m

# AES-256-GCM key for platform tokens — 32 bytes as 64 hex chars
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace-with-64-hex-characters

# Spotify — https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/v1/auth/spotify/callback

# YouTube / Google — https://console.cloud.google.com
YOUTUBE_CLIENT_ID=your_google_client_id
YOUTUBE_CLIENT_SECRET=your_google_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/v1/auth/youtube/callback

# Apple Music — https://developer.apple.com/documentation/applemusicapi
# Requires Apple Developer Program membership ($99/yr)
# Create a MusicKit key at: developer.apple.com → Certificates, Identifiers & Profiles → Keys
APPLE_MUSIC_TEAM_ID=your_team_id
APPLE_MUSIC_KEY_ID=your_musickit_key_id
# Paste the full .p8 key content; replace actual newlines with \n (quoted string in .env)
APPLE_MUSIC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Frontend URL (for OAuth redirects after callback)
FRONTEND_URL=http://localhost:5173

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173

# Sync polling interval in ms (default: 5 minutes)
POLL_INTERVAL_MS=300000
